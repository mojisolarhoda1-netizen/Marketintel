# Copy this file to .env and fill in only what you use. Placeholders only — never commit real keys.

# --- Free with setup -------------------------------------------------------
# YouTube Data API v3 key (Google Cloud Console > APIs & Services > Credentials). Free, 10,000 units/day.
YOUTUBE_API_KEY=
# Stop before Google's daily limits: 10,000 units/day for stats; search has its own 100 calls/day
YOUTUBE_DAILY_UNIT_BUDGET=8000
YOUTUBE_DAILY_SEARCH_BUDGET=90

# Instagram Business Discovery (free Meta developer app in Development mode)
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v26.0
# Public Business/Creator account used by `validate` to test your token (default: instagram)
IG_TEST_USERNAME=instagram

# --- Free local AI (optional) ----------------------------------------------
# Install from https://ollama.com then run:  ollama pull llama3.2:3b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Paid services: switched off. Leave these empty. ------------------------
ALLOW_PAID_AI=false
ANTHROPIC_API_KEY=

# --- App --------------------------------------------------------------------
# Leave HOST as 127.0.0.1 so only this computer can open the app.
HOST=127.0.0.1
PORT=5000
# SECRET_KEY is generated automatically into data/.secret_key if left empty.
SECRET_KEY=

# --- Free AI strategist (Research page) -------------------------------------
# Groq free tier: sign up at console.groq.com (no card) > API Keys > Create. Groq doesn't train on API data.
GROQ_API_KEY=
# Optional: force a model id (otherwise picked automatically from what Groq offers)
GROQ_MODEL=
